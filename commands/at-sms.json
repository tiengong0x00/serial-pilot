{
  "version": "1.0",
  "name": "SMS",
  "commands": [
    { "command": "AT+CMGF", "category": "sms", "description": "Set SMS format (0=PDU, 1=Text)", "example": "AT+CMGF=1" },
    { "command": "AT+CMGS", "category": "sms", "description": "Send SMS", "example": "AT+CMGS=\"10086\"" },
    { "command": "AT+CMGR", "category": "sms", "description": "Read SMS", "example": "AT+CMGR=1" },
    { "command": "AT+CMGL", "category": "sms", "description": "List SMS", "example": "AT+CMGL=\"ALL\"" },
    { "command": "AT+CMGD", "category": "sms", "description": "Delete SMS", "example": "AT+CMGD=1" },
    { "command": "AT+CNMI", "category": "sms", "description": "Configure new SMS notification" }
  ]
}
