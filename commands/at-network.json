{
  "version": "1.0",
  "name": "Network Management",
  "commands": [
    { "command": "AT+CREG", "category": "network", "description": "Query network registration status", "example": "AT+CREG?" },
    { "command": "AT+CGREG", "category": "network", "description": "Query GPRS registration status", "example": "AT+CGREG?" },
    { "command": "AT+CEREG", "category": "network", "description": "Query LTE registration status", "example": "AT+CEREG?" },
    { "command": "AT+COPS", "category": "network", "description": "Query/select operator", "example": "AT+COPS?" },
    { "command": "AT+CGATT", "category": "network", "description": "Query/set GPRS attach status", "example": "AT+CGATT=1" },
    { "command": "AT+CGDCONT", "category": "network", "description": "Configure PDP context (APN)", "example": "AT+CGDCONT=1,\"IP\",\"cmnet\"" },
    { "command": "AT+CGACT", "category": "network", "description": "Activate/deactivate PDP context", "example": "AT+CGACT=1,1" },
    { "command": "AT+CGPADDR", "category": "network", "description": "Query assigned IP address" }
  ]
}
