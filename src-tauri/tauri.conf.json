{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serial Pilot",
  "version": "0.1.0",
  "identifier": "com.serialpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Serial Pilot",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": ["../testcases/*", "../commands/*", "../scripts/*"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGRTNGOTcyMzRENTE4NUEKUldSYUdOVTBjdm5qUDdDeUVYaTZyMlRPM0pRa3pTakFTcjhycyt0dUtBdG93Z2ZKVG9TLzhOUm4K",
      "endpoints": [
        "https://github.com/tian340825/serial-pilot/releases/latest/download/latest.json"
      ]
    }
  }
}
