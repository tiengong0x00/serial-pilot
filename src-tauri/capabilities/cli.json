{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "cli",
  "description": "Capabilities for CLI mode",
  "windows": ["cli-window"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$RESOURCE/*" },
        { "path": "$APPDATA/*" },
        { "path": "$APPCONFIG/*" },
        { "path": "$APPLOCALDATA/*" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/*" },
        { "path": "$APPCONFIG/*" },
        { "path": "$APPLOCALDATA/*" }
      ]
    }
  ]
}
